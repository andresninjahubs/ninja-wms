# Copia este archivo a .env y ajusta los valores.

# Puerto HTTP del WMS
PORT=3000

# Persistencia: "memory" (sin base de datos) o "prisma" (PostgreSQL)
PERSISTENCE=memory

# Conexión a PostgreSQL (solo necesaria con PERSISTENCE=prisma)
DATABASE_URL="postgresql://wms:wms@localhost:5432/wms?schema=public"

# --- Campañas y leads (opcional) ---------------------------------------------
# Medición Google Ads / GA4 en el panel (se carga gtag.js solo si GTAG_ID existe).
GTAG_ID=                 # ej: AW-123456789 (Google Ads) o G-XXXXXXX (GA4)
ADS_CONVERSION=          # ej: AW-123456789/AbCdEfGh — conversión "Registro cuenta Free"
# Aviso inmediato de cada cuenta nueva (para contactar en menos de 1 hora).
LEAD_WEBHOOK_URL=        # POST JSON {event:'lead.created', companyName, name, email, phone, track, source}
LEAD_NOTIFY_EMAIL=       # correo del comercial (requiere SMTP configurado)
