# ─────────────────────────────────────────────────────────────────────────────
# Variables de PRODUCCIÓN del WMS Ninja.
# En Railway/Render se cargan como "Variables" del servicio (NO subas un .env real).
# Genera los secretos tú mismo; NO uses estos valores de ejemplo.
# ─────────────────────────────────────────────────────────────────────────────

# --- Base de datos: obligatorio en producción ---
PERSISTENCE=prisma
# En Railway, referencia la base con: ${{Postgres.DATABASE_URL}}
# (en un servidor propio: postgresql://usuario:clave@host:5432/wms?schema=public)
DATABASE_URL=postgresql://usuario:clave@host:5432/wms?schema=public

# --- Seguridad: obligatorio en producción ---
# Exige token válido en cada endpoint protegido.
AUTH_REQUIRED=true
# Secreto para firmar las sesiones (JWT). Genera uno con:  openssl rand -hex 32
AUTH_SECRET=CAMBIA_ESTO_por_un_secreto_largo_y_aleatorio
# Duración de la sesión.
AUTH_TOKEN_TTL=12h
# Clave inicial del super-administrador de plataforma (usuario admin@ninjahubs.cl).
# Cámbiala tras el primer ingreso desde el panel.
ROOT_PASSWORD=CAMBIA_ESTO_por_una_clave_fuerte

# --- Datos de demostración: APAGADO en una plataforma pública ---
# En true crea usuarios y datos de ejemplo (clave demo1234). En producción: false.
SEED_DEMO=false

# --- Red ---
# Restringe el origen del navegador a tu dominio (ej: https://wms.tudominio.cl).
CORS_ORIGIN=https://wms.tudominio.cl
# PORT lo inyecta la plataforma; localmente por defecto 3000.
# PORT=3000

# --- Marca (white-label) opcional ---
BRAND_APP_NAME=Ninja WMS
BRAND_PRIMARY_COLOR=#0E9F6E
# BRAND_LOGO_URL=/brand/logo.svg

# --- Correo para envío de facturas (opcional) ---
# SMTP_URL=smtp://usuario:clave@smtp.tuproveedor.cl:587
# SMTP_FROM=Ninja Hubs WMS <facturacion@tudominio.cl>

# Módulos del panel ocultos en esta versión (ids de sección separados por coma).
# Sin definir → default de la versión: voz,costos,plan,aiaudit,asignaciones,agente. Vacío ("") → se muestra todo.
# El super-admin de plataforma los sigue viendo salvo HIDDEN_MODULES_FOR_PLATFORM=true.
# HIDDEN_MODULES=voz,costos,plan,aiaudit,asignaciones,agente
# HIDDEN_MODULES_FOR_PLATFORM=false

# ---- Agente autónomo (v83, Fase 1) ----------------------------------------------
# El agente corre en el SERVIDOR con su propio reloj (no depende del panel abierto).
# AGENT_SCHEDULER=false lo apaga; AGENT_INTERVAL_SEC es la frecuencia del ciclo.
# El nivel de autonomía, el modo sombra, los límites y las notificaciones se
# configuran por operación desde el panel (Administración → Agente).
# AGENT_SCHEDULER=true
# AGENT_INTERVAL_SEC=120
# AGENT_ROLLUP_HOUR_UTC=3
# Presupuestos del loop del copiloto/agente por turno (opcionales).
# COPILOT_MAX_ROUNDS=14
# COPILOT_MAX_TOOL_CALLS=30
# COPILOT_TURN_TIMEOUT_MS=90000
